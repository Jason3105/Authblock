# ─── App ─────────────────────────────────────────────────────────────────────
# Public URL of your deployed app (used for SEO metadataBase & og:image).
# Set this to your Amplify domain, e.g. https://main.abc123.amplifyapp.com
NEXT_PUBLIC_APP_URL=https://your-amplify-domain.amplifyapp.com

# ─── Database (PostgreSQL - NeonDB) ──────────────────────────────────────────
DATABASE_URL=your_neon_db_url_here

# ─── Firebase (Admin login via Google OAuth) ─────────────────────────────────
# Get values from https://console.firebase.google.com → Project Settings → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Blockchain (Ethereum / Sepolia) ─────────────────────────────────────────
# Get an Alchemy key from https://dashboard.alchemy.com
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_key

# Deployed smart contract addresses
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYourMarksheetContractAddress
NEXT_PUBLIC_QR_CONTRACT_ADDRESS=0xYourQRContractAddress

# Private key of the wallet used to sign transactions (keep secret, never commit!)
PRIVATE_KEY=your_private_key_for_contract_deployment

# ─── AWS S3 (Certificate / PDF storage) ──────────────────────────────────────
S3_REGION=ap-south-1
S3_BUCKET_NAME=your_s3_bucket_name
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─── Email (SMTP via Gmail App Password) ─────────────────────────────────────
# Create a Gmail App Password at https://myaccount.google.com/apppasswords
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password

# ─── OCR APIs ────────────────────────────────────────────────────────────────
# Free OCR.space key (25,000 req/month): https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your_ocr_space_api_key

# Optional: Google Cloud Vision (better accuracy, paid)
# Get key from: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# ─── WalletConnect ───────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
